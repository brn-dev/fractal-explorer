        </service>
        <service android:name=".CoverWallpaperService" android:exported="true" android:permission="android.permission.BIND_WALLPAPER" android:label="Fractal Wallpaper · Cover">
            <intent-filter><action android:name="android.service.wallpaper.WallpaperService" /></intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper" />
        </service>
    </application>
</manifest>
